void ordenarBubble(){
    int i, j, aux;
    int contagem = 0;
    int comparacoes = 0;
    int contagem1 = 0;
    int comparacoes1 = 0;
    printf("\n====PRECOS ORDENADOS DO MENOR PARA O MAIOR(Bubble Sort)====\n");
    for (i = 0; i < 4; i++)
    {
        for (j = 0; j < 4 - i; j++)
        {
           comparacoes++;
            if (precos[j] > precos[j + 1])
            {
                aux = precos[j];
                precos[j] = precos[j + 1];
                precos[j + 1] = aux;
                contagem++;
            }
        }
    }
    for (i = 0; i < 5; i++)
    {
        printf("%d ", precos[i]);
    }
    printf("\nQuantidade de trocas: %d", contagem);
    printf("\nQuantidade de comparacoes: %d", comparacoes);

    printf("\n====PRECOS ORDENADOS DO MAIOR PARA O MENOR(Bubble Sort)====\n");
    for (i = 0; i < 4; i++){
        for (j = 0; j < 4 - i; j++){
            comparacoes1++;
            if (precos[j] < precos[j + 1])
            {
                aux = precos[j];
                precos[j] = precos[j + 1];
                precos[j + 1] = aux;
                contagem1++;
            }
        }
    }

    for (i = 0; i < 5; i++){
        printf("%d ", precos[i]);
    }
    printf("\nQuantidade de trocas: %d", contagem1);
    printf("\nQuantidade de comparacoes: %d", comparacoes1);

}

void ordenarInsertion(){
    int i, j, chave;
    int trocas = 0;
    int comparacoes = 0;

    printf("\n====PRECOS ORDENADOS(Insertion Sort)====\n");

    for(i = 1; i < 5; i++){
        chave = precos[i];
        j = i - 1;

        while(j >= 0 && precos[j] > chave){
            comparacoes++;      
            precos[j + 1] = precos[j];
            trocas++;         
            j--;
        }

        if(j >= 0)
        comparacoes++; 
        precos[j + 1] = chave;
    }

    for(i = 0; i < 5; i++){
        printf("%d ", precos[i]);
    }

    printf("\n\nQuantidade de comparacoes: %d", comparacoes);
    printf("\nQuantidade de trocas: %d", trocas);
}


void ordenarSelection(){
    int i, j, menor, temp;
    int contagem = 0;
    int comparacoes = 0;

    for(i = 0; i < 4; i++)
    {
        menor = i;

        for(j = i + 1; j < 5; j++)
        {
            comparacoes++;
            if(precos[j] < precos[menor]){
                menor = j;
            }
        }
        if(menor != i){
        temp = precos[i];
        precos[i] = precos[menor];
        precos[menor] = temp;
        contagem++;
}
    }

printf("\n====PRECOS ORDENADOS(Selection Sort)====\n");

    for(i = 0; i < 5; i++)
        printf("%d ", precos[i]);

printf("\n====Log de funcionamento====\n");
printf("\nQuantidade de trocas: %d", contagem);
printf("\nQuantidade de comparacoes: %d", comparacoes);
}


