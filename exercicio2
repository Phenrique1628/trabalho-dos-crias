    int busca, i;
    int encontrado = 0;

    printf("\nDigite o codigo a buscar: ");
    scanf("%d", &busca);

    for(i=0;i < 5;i++){
        if (codigo[i] == busca) {
         printf("\nPreco e Quantidade do produto encontrado a partir do codigo(respectivamente): %d e %d\n", precos[i], quantidades[i]);
         encontrado = 1;
         break;
        }
    }

    if (encontrado == 0)
    printf("\nElemento nao encontrado.\n");
}

void buscaBinaria(){
    int inicio = 0;
    int fim = 4;
    int meio;
    int buscaCodigo;
    printf("\nDigite o codigo a buscar: ");
    scanf("%d", &buscaCodigo);
    while(inicio <= fim)
    {
        meio = (inicio + fim) / 2;
        if(codigo[meio] == buscaCodigo)
        {
            printf("\nQuantidade e preco do produto encontrado a partir do codigo(respectivamente): %d e %d", quantidades[meio], precos[meio]);
            return;
        }
        else if(buscaCodigo > codigo[meio])
            inicio = meio + 1;
        else
            fim = meio - 1;
    }
    printf("\nElemento nao encontrado.\n");
}
