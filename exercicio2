#include <stdio.h>
void mostrarProdutos();
void ordenarBubble();
void ordenarInsertion();
void buscaBinaria();
int codigo[5] = {2, 4, 6, 8, 10};
int quantidades[5] = {10, 20, 30, 40, 50};
int precos[5] = {25, 12, 47, 10, 50};

int main() {
    int escolha;
    int codigo, quantidade;

    printf("======MENU======");
    printf("\n1- Ordenar com Bubble Sort");
    printf("\n2- Ordenar com Insertion Sort");
    printf("\n3- Ordenar com Selection Sort");
    printf("\n4- Buscar um produto com Sequencial");
